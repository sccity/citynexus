APP_NAME="CityNexus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Main Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citynexus
DB_USERNAME=dbuser
DB_PASSWORD=

# Service Health Database
SERVICE_HEALTH_DB_HOST=apps.db.svc.cluster.local
SERVICE_HEALTH_DB_PORT=3306
SERVICE_HEALTH_DB_DATABASE=ServiceHealth
SERVICE_HEALTH_DB_USERNAME=
SERVICE_HEALTH_DB_PASSWORD=

# GovTxt Database
GOVTXT_DB_HOST=apps.db.svc.cluster.local
GOVTXT_DB_PORT=3306
GOVTXT_DB_DATABASE=govtxt
GOVTXT_DB_USERNAME=
GOVTXT_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Keycloak Configuration
# Development Environment (citynexus-dev.santaclarautah.gov)
KEYCLOAK_BASE_URL=https://sso.santaclarautah.gov
KEYCLOAK_REALM=SANTACLARA-DEV
KEYCLOAK_CLIENT_ID=citynexus-dev
KEYCLOAK_CLIENT_SECRET=your-dev-client-secret
KEYCLOAK_REDIRECT_URI=https://citynexus-dev.santaclarautah.gov/auth/callback

# Local Development (localhost)
# KEYCLOAK_BASE_URL=https://sso.santaclarautah.gov
# KEYCLOAK_REALM=SANTACLARA-DEV
# KEYCLOAK_CLIENT_ID=citynexus-local
# KEYCLOAK_CLIENT_SECRET=your-local-client-secret
# KEYCLOAK_REDIRECT_URI=http://localhost/auth/callback

KEYCLOAK_OPENID_CONNECT_PATH=/protocol/openid-connect

VITE_APP_NAME="${APP_NAME}"
